echo "Running pre-commit checks..."

# Run lint-staged to handle all checks on staged files
# (ESLint, Prettier, Secretlint)
pnpm lint-staged

# Run checks that apply to the whole project

# 1. TypeScript compilation check
echo "Checking for TypeScript compilation errors..."
pnpm run compile || (echo "TypeScript compilation failed. Please fix the errors before committing." && exit 1)

# 2. Full test suite
echo "Running tests (this may take a while)..."
pnpm test || (echo "Tests failed. Please fix the tests before committing." && exit 1)

# 3. Dependency audit
echo "Running dependency audit..."
pnpm audit || (echo "pnpm audit found vulnerabilities. Please review and fix them before committing." && exit 1)


echo "Pre-commit checks passed."